    "    \"        tier=tier_name,\\n\",\n",
    "    \"        epochs=FINAL_EPOCHS,\\n\",\n",
    "    \"        batch_size=best_hp.get(\\\"batch_size\\\", 16),\\n\",\n",
    "    \"        lr=best_hp.get(\\\"lr\\\", 5e-4),\\n\",\n",
    "    \"        export_onnx=EXPORT_ONNX,\\n\",\n",
    "    \"        device=DEVICE,\\n\",\n",
    "    \"        download_augmentation=False,  # already done in Cell 4\\n\",\n",
    "    \"        seed=SEED,\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"    result = _train_from_datagen_result(tier_cfg, datagen_result)\\n\",\n",
    "    \"    final_results.append({\\n\",\n",
    "    \"        \\\"tier\\\": tier_name,\\n\",\n",
    "    \"        \\\"f1\\\":   result.metrics.get(\\\"f1\\\", 0.0),\\n\",\n",
    "    \"        \\\"onnx\\\": result.best_onnx_path,\\n\",\n",
    "    \"        \\\"pt\\\":   result.best_model_path,\\n\",\n",
    "    \"    })\\n\",\n",
    "    \"    print(f\\\"  {tier_name:20s}  F1={result.metrics.get('f1', 0):.3f}\\\")\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"cell-08-header\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Cell 8 — Tier comparison\\n\",\n",
    "    \"\\n\",\n",
    "    \"Bar chart of test-set F1 for each trained tier.  \\n\",\n",
    "    \"Use this to pick the right accuracy/size trade-off for your deployment target.  \\n\",\n",
    "    \"Saved to `OUTPUT_DIR/tier_comparison.png`.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
