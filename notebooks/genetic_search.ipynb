    "   \"source\": [\n",
    "    \"## Cell 2 — Configuration\\n\",\n",
    "    \"This is the **only cell you need to edit**. All values can also be set as environment variables.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"cell-02\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-03-20T03:02:19.692511Z\",\n",
    "     \"start_time\": \"2026-03-20T03:02:19.686806Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"import os\\n\",\n",
    "    \"\\n\",\n",
    "    \"WAKE_WORD          = os.environ.get(\\\"WAKE_WORD\\\",          \\\"hey mycroft\\\")\\n\",\n",
    "    \"OUTPUT_DIR         = os.environ.get(\\\"OUTPUT_DIR\\\",         \\\"./ww_output\\\")\\n\",\n",
    "    \"LANG               = os.environ.get(\\\"LANG_CODE\\\",          \\\"en\\\")\\n\",\n",
    "    \"N_POSITIVE         = int(os.environ.get(\\\"N_POSITIVE\\\",     \\\"200\\\"))\\n\",\n",
    "    \"ADVERSARIAL        = os.environ.get(\\\"ADVERSARIAL\\\",        \\\"false\\\").lower()  == \\\"true\\\"\\n\",\n",
    "    \"DOWNLOAD_AUGMENT   = os.environ.get(\\\"DOWNLOAD_AUGMENT\\\",   \\\"true\\\").lower() == \\\"true\\\"\\n\",\n",
    "    \"# Dataset overrides (leave empty to use auto mode)\\n\",\n",
    "    \"CUSTOM_TRAIN_CSV   = os.environ.get(\\\"CUSTOM_TRAIN_CSV\\\",   \\\"\\\")  # path,label CSV\\n\",\n",
    "    \"CUSTOM_TEST_CSV    = os.environ.get(\\\"CUSTOM_TEST_CSV\\\",    \\\"\\\")  # optional; 80/20 split if absent\\n\",\n",
    "    \"HF_DATASET         = os.environ.get(\\\"HF_DATASET\\\",         \\\"\\\")  # e.g. \\\"org/repo\\\"\\n\",\n",
    "    \"# Negative / augmentation overrides (all optional, all stackable)\\n\",\n",
    "    \"NEGATIVES_DIR      = os.environ.get(\\\"NEGATIVES_DIR\\\",      \\\"\\\")  # local audio dir\\n\",\n",
    "    \"EXTRA_NEGATIVES_HF = os.environ.get(\\\"EXTRA_NEGATIVES_HF\\\", \\\"\\\")  # \\\"org/r1,org/r2\\\"\\n\",\n",
    "    \"BG_NOISE_DIR       = os.environ.get(\\\"BG_NOISE_DIR\\\",       \\\"\\\")\\n\",\n",
    "    \"EXTRA_BG_NOISE_HF  = os.environ.get(\\\"EXTRA_BG_NOISE_HF\\\",  \\\"\\\")\\n\",\n",
    "    \"MUSIC_DIR          = os.environ.get(\\\"MUSIC_DIR\\\",          \\\"\\\")\\n\",\n",
    "    \"EXTRA_MUSIC_HF     = os.environ.get(\\\"EXTRA_MUSIC_HF\\\",     \\\"\\\")\\n\",\n",
    "    \"RIR_DIR            = os.environ.get(\\\"RIR_DIR\\\",            \\\"\\\")\\n\",\n",
    "    \"EXTRA_RIR_HF       = os.environ.get(\\\"EXTRA_RIR_HF\\\",       \\\"\\\")\\n\",\n",
    "    \"# Genetic search knobs\\n\",\n",
    "    \"POPULATION         = int(os.environ.get(\\\"POPULATION\\\",     \\\"12\\\"))\\n\",\n",
    "    \"GENERATIONS        = int(os.environ.get(\\\"GENERATIONS\\\",    \\\"5\\\"))\\n\",\n",
    "    \"EPOCHS_PER_TRIAL   = int(os.environ.get(\\\"EPOCHS_PER_TRIAL\\\", \\\"3\\\"))\\n\",\n",
    "    \"SEARCH_FULL        = os.environ.get(\\\"SEARCH_FULL\\\",        \\\"false\\\").lower() == \\\"true\\\"\\n\",\n",
    "    \"# Search strategy (wakegp-inspired)\\n\",\n",
    "    \"SEARCH_DEMES       = int(os.environ.get(\\\"SEARCH_DEMES\\\",        \\\"1\\\"))\\n\",\n",
    "    \"SEARCH_MAX_MINUTES = float(os.environ.get(\\\"SEARCH_MAX_MINUTES\\\", \\\"0\\\")) or None\\n\",\n",
    "    \"SEARCH_TARGET_F1   = float(os.environ.get(\\\"SEARCH_TARGET_F1\\\",  \\\"0\\\")) or None\\n\",\n",
    "    \"SEARCH_FITNESS_FN  = os.environ.get(\\\"SEARCH_FITNESS_FN\\\",       \\\"f1\\\")\\n\",\n",
    "    \"SEARCH_TWO_STAGE   = os.environ.get(\\\"SEARCH_TWO_STAGE\\\",        \\\"false\\\").lower() == \\\"true\\\"\\n\",\n",
    "    \"STAGE2_POPULATION  = int(os.environ.get(\\\"STAGE2_POPULATION\\\",   \\\"8\\\"))\\n\",\n",
    "    \"STAGE2_GENERATIONS = int(os.environ.get(\\\"STAGE2_GENERATIONS\\\",  \\\"3\\\"))\\n\",\n",
    "    \"# Final model training\\n\",\n",
    "    \"TIERS_TO_TRAIN     = os.environ.get(\\\"TIERS_TO_TRAIN\\\",     \\\"micro,small,filterbank_small\\\").split(\\\",\\\")\\n\",\n",
    "    \"FINAL_EPOCHS       = int(os.environ.get(\\\"FINAL_EPOCHS\\\",   \\\"30\\\"))\\n\",\n",
    "    \"EXPORT_ONNX        = os.environ.get(\\\"EXPORT_ONNX\\\",        \\\"true\\\").lower()  == \\\"true\\\"\\n\",\n",
    "    \"DEVICE             = os.environ.get(\\\"DEVICE\\\",             \\\"auto\\\")\\n\",\n",
    "    \"SEED               = int(os.environ.get(\\\"SEED\\\",           \\\"42\\\"))\"\n",
