    "   \"source\": [\n",
    "    \"## Cell 3 — Install & platform detection\\n\",\n",
    "    \"Installs all required packages and auto-detects the current platform.\\n\",\n",
    "    \"**Safe to skip** if running in an environment where `ww_trainer` and the OVOS stack are already installed.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"cell-03\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-03-20T03:02:47.862505Z\",\n",
    "     \"start_time\": \"2026-03-20T03:02:45.837904Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"import subprocess, sys\\n\",\n",
    "    \"\\n\",\n",
    "    \"def _pip(*pkgs):\\n\",\n",
    "    \"    subprocess.check_call([sys.executable, \\\"-m\\\", \\\"pip\\\", \\\"install\\\", \\\"-q\\\", *pkgs])\\n\",\n",
    "    \"\\n\",\n",
    "    \"_pip(\\\"torch\\\", \\\"torchaudio\\\", \\\"soundfile\\\", \\\"numpy\\\", \\\"scikit-learn\\\",\\n\",\n",
    "    \"     \\\"matplotlib\\\", \\\"librosa\\\", \\\"onnx\\\", \\\"onnxruntime\\\", \\\"click\\\", \\\"tqdm\\\")\\n\",\n",
    "    \"_pip(\\\"ovos-plugin-manager\\\", \\\"ovos-tts-plugin-edge-tts\\\",\\n\",\n",
    "    \"     \\\"ovos-vad-plugin-silero\\\", \\\"datasets\\\")\\n\",\n",
    "    \"try:\\n\",\n",
    "    \"    import ww_trainer\\n\",\n",
    "    \"except ImportError:\\n\",\n",
    "    \"    _pip(\\\"ww_trainer\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"import os\\n\",\n",
    "    \"_platform = (\\n\",\n",
    "    \"    \\\"kaggle\\\"     if os.path.exists(\\\"/kaggle\\\")     else\\n\",\n",
    "    \"    \\\"paperspace\\\" if os.path.exists(\\\"/notebooks\\\")  else\\n\",\n",
    "    \"    \\\"colab\\\"      if \\\"google.colab\\\" in sys.modules else\\n\",\n",
    "    \"    \\\"local\\\"\\n\",\n",
    "    \")\\n\",\n",
    "    \"print(f\\\"Platform: {_platform} | Device: {DEVICE} | Wake word: {WAKE_WORD!r}\\\")\"\n",
